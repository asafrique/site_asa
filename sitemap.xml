---
layout: null
sitemap: false
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{%- for p in site.html_pages %}{% unless p.sitemap == false %}
  <url><loc>{{ p.url | replace: 'index.html', '' | absolute_url }}</loc><lastmod>{{ site.time | date_to_xmlschema }}</lastmod></url>
{%- endunless %}{% endfor %}
{%- for a in site.posts %}
  <url><loc>{{ a.url | absolute_url }}</loc><lastmod>{{ a.last_modified_at | default: a.date | date_to_xmlschema }}</lastmod></url>
{%- endfor %}
</urlset>
